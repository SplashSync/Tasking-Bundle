{
    "name":         "badpixxel/tasking-bundle",
    "description":  "Advanced Tasking Bundle for Symfony Applications (100% PHP)",
    "type":         "symfony-bundle",
    "keywords":     ["Symfony", "Bundle", "Task", "PHP", "Tasking"],
    "homepage":     "http://www.badpixxel.com",
    "license":      "MIT",
    "prefer-stable": true,
    "version":      "3.0",

    "authors": [
        {
            "name": "Bernard Paquier",
            "email": "eshop.bpaquier@gmail.com"
        }
    ],
    
    "autoload": {
        "psr-4": {
            "BadPixxel\\Tasking\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BadPixxel\\Tasking\\Tests\\": "tests"
        }
    },
    
    "require": {
        "php":                                          "^8.1",
        "ext-posix":                                    "*",
        "ext-curl":                                     "*",
        "ext-pcntl":                                    "*",

        "symfony/config":                               "^5.4|^6.4|^7.0",
        "symfony/dependency-injection":                 "^5.4|^6.4|^7.0",
        "symfony/event-dispatcher":                     "^5.4|^6.4|^7.0",
        "symfony/options-resolver":                     "^5.4|^6.4|^7.0",
        "symfony/monolog-bundle":                       "^3.0",
        "twig/extra-bundle":                            ">=3.0",
        "twig/intl-extra":                              ">=3.0",

        "doctrine/doctrine-bundle":                     "^2.0",

        "sonata-project/admin-bundle":                  "^4.0",
        "sonata-project/doctrine-orm-admin-bundle":     "*",

        "monolog/monolog":                              "^1.25.1|^2",
        "webmozart/assert":                             "^1.0"
    },
    
    "require-dev": {
        "badpixxel/php-sdk":                            "3.0.x-dev",
        "badpixxel/paddock-core":                       "dev-main",

        "symfony/http-kernel":                          "^5.4|^6.4|^7.0",
        "symfony/console":                              "^5.4|^6.4|^7.0",
        "symfony/framework-bundle":                     "^5.4|^6.4|^7.0",
        "symfony/runtime":                              "^5.4|^6.4|^7.0",
        "symfony/flex":                                 "^1.0|^2.0",
        "symfony/debug-bundle":                         "^5.4|^6.4|^7.0",
        "symfony/web-profiler-bundle":                  "^5.4|^6.4|^7.0",
        "symfony/phpunit-bridge":                       "^6.0",
        "symfony/ux-live-component":                    "^2.0",
        "symfony/webpack-encore-bundle": "^1.7|^2.0",

        "sentry/sentry-symfony":                        "^4.0"
    },
    
    "config": {
        "preferred-install":                        "dist",
        "allow-plugins": {
            "phpro/grumphp-shim":                   true,
            "php-http/discovery":                   true,
            "symfony/runtime":                      true,
            "symfony/flex":                         true
        }
    },

    "extra": {
        "public-dir":                               "tests/public",
        "config-dir":                               "tests/config"

    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR% --symlink": "symfony-cmd"
        },
        "post-update-cmd": "@auto-scripts",
        "post-install-cmd": "@auto-scripts"
    }
}
