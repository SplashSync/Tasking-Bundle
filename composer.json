{
    "name":                 "badpixxel/tasking-bundle",
    "description":          "Advanced Tasking Bundle for Symfony Applications (100% PHP)",
    "type":                 "symfony-bundle",
    "keywords":             ["Symfony", "symfony-ux", "Bundle", "Task", "PHP", "Tasking"],
    "homepage":             "http://www.badpixxel.com",
    "license":              "MIT",
    "minimum-stability":    "dev",
    "prefer-stable":        true,
    "version":              "3.0",

    "authors": [
        {
            "name": "Bernard Paquier",
            "email": "eshop.bpaquier@gmail.com"
        }
    ],
    
    "autoload": {
        "psr-4": {
            "BadPixxel\\Tasking\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BadPixxel\\Tasking\\Tests\\": "tests"
        }
    },
    
    "require": {
        "php":                                          "^8.1",
        "ext-posix":                                    "*",
        "ext-curl":                                     "*",
        "ext-pcntl":                                    "*",

        "symfony/http-kernel":                          "^6.4|^7.4|^8.0",
        "symfony/console":                              "^6.4|^7.4|^8.0",
        "symfony/config":                               "^6.4|^7.4|^8.0",
        "symfony/dependency-injection":                 "^6.4|^7.4|^8.0",
        "symfony/event-dispatcher":                     "^6.4|^7.4|^8.0",
        "symfony/options-resolver":                     "^6.4|^7.4|^8.0",
        "symfony/asset-mapper":                         "^6.4|^7.4|^8.0",
        "symfony/monolog-bundle":                       "^3.0|^4.0",

        "doctrine/doctrine-bundle":                     "^2.0",

        "sonata-project/admin-bundle":                  "^4.0",
        "sonata-project/doctrine-orm-admin-bundle":     "^4.0",

        "monolog/monolog":                              "^3.0",
        "webmozart/assert":                             "^1.0"
    },
    
    "require-dev": {
        "badpixxel/php-sdk":                            "^3.0",
        "badpixxel/paddock-core":                       "dev-main",

        "symfony/framework-bundle":                     "^6.4|^7.4|^8.0",
        "symfony/runtime":                              "^6.4|^7.4|^8.0",
        "symfony/twig-bundle":                          "^6.4|^7.4|^8.0",
        "symfony/phpunit-bridge":                       "^6.4|^7.4|^8.0",
        "symfony/debug-bundle":                         "^6.4|^7.4|^8.0",
        "symfony/stopwatch":                            "^6.4|^7.4|^8.0",
        "symfony/web-profiler-bundle":                  "^6.4|^7.4|^8.0",
        "symfony/ux-live-component":                    "^2.0",
        "symfony/flex":                                 "^1.0|^2.0",

        "twig/extra-bundle":                            ">=3.0",
        "twig/intl-extra":                              ">=3.0",

        "sentry/sentry-symfony":                        "^4.0|^5.0"
    },
    
    "config": {
        "preferred-install":                        "dist",
        "allow-plugins": {
            "phpro/grumphp-shim":                   true,
            "php-http/discovery":                   true,
            "symfony/runtime":                      true,
            "symfony/flex":                         true
        }
    },

    "extra": {
        "public-dir":                               "tests/public",
        "config-dir":                               "var/config"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR% --symlink": "symfony-cmd",
            "doctrine:schema:update --force": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-update-cmd":  "@auto-scripts",
        "post-install-cmd": "@auto-scripts"
    }
}
