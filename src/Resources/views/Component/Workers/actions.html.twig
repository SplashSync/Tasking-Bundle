<div {{ attributes }} class="btn-group" role="group" >
        <button
                type="button"
                class="btn btn-secondary"
                data-action="live#action"
                data-live-action-param="check"
        >
                Check
        </button>

        <button
                type="button"
                class="btn btn-success"
                data-action="live#action"
                data-live-action-param="start"
        >
                Start
        </button>

        <button
                type="button"
                class="btn btn-danger"
                data-action="live#action"
                data-live-action-param="stop"
        >
                Stop
        </button>
</div>